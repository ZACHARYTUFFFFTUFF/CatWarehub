local espEnabled = { Players = false, Bots = false, Downed = false, Items = false }
local espHighlights = {}
local rainbowESP = false

local function CreateESP(target, color, text, sub)
    if not target or not target.Parent then return end
    if espHighlights[target] then return espHighlights[target] end
    
    local hl = New("Highlight", {
        Parent = target,
        FillColor = color,
        FillTransparency = 0.6,
        OutlineColor = color,
        OutlineTransparency = 0,
        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
    })
    
    local bb = New("BillboardGui", {
        Parent = target,
        Size = UDim2.new(0, SC(130), 0, SC(50)),
        StudsOffset = Vector3.new(0, 3.5, 0),
        AlwaysOnTop = true,
    })
    local lbl = New("TextLabel", {
        Parent = bb,
        Size = UDim2.new(1, 0, 0.5, 0),
        BackgroundTransparency = 1,
        Text = text or target.Name,
        TextColor3 = color,
        TextStrokeTransparency = 0.5,
        Font = Enum.Font.GothamBold,
        TextSize = SC(11),
    })
    local subLbl = New("TextLabel", {
        Parent = bb,
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.new(1, 0, 0.5, 0),
        BackgroundTransparency = 1,
        Text = sub or "",
        TextColor3 = color,
        TextStrokeTransparency = 0.5,
        Font = Enum.Font.Gotham,
        TextSize = SC(9),
    })
    
    espHighlights[target] = { Highlight = hl, Billboard = bb, Label = lbl, SubLabel = subLbl, Color = color }
    return espHighlights[target]
end

local function RemoveESP(target)
    if espHighlights[target] then
        local d = espHighlights[target]
        if d.Highlight then d.Highlight:Destroy() end
        if d.Billboard then d.Billboard:Destroy() end
        espHighlights[target] = nil
    end
end

local function ClearESP()
    for target, _ in pairs(espHighlights) do
        RemoveESP(target)
    end
end

