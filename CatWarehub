Services.RunService.Heartbeat:Connect(function(dt)
    if not airStrafe then return end
    local hum = GetHum()
    local root = GetRoot()
    if not hum or not root then return end
    if hum.FloorMaterial ~= Enum.Material.Air then return end
    
    local camCF = Camera.CFrame
    local flatRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit
    local moveDir = hum.MoveDirection
    if moveDir.Magnitude < 0.1 then return end
    
    local strafeAmt = moveDir:Dot(flatRight)
    if math.abs(strafeAmt) < 0.2 then return end
    
    local currentVel = root.AssemblyLinearVelocity
    local accelDir = flatRight * math.sign(strafeAmt)
    local newVel = Vector3.new(currentVel.X, 0, currentVel.Z) + accelDir * airStrafeRate * dt
    root.AssemblyLinearVelocity = Vector3.new(newVel.X, currentVel.Y, newVel.Z)
end)

