            TextSize = SC(12),
            AutoButtonColor = false,
            Parent = page,
        })
        Corner(btn, 8)
        Stroke(btn, Theme.Accent)
        
        btn.MouseEnter:Connect(function()
            Tween(btn, { BackgroundTransparency = 0.8, BackgroundColor3 = Theme.Accent }, 0.15)
        end)
        btn.MouseLeave:Connect(function()
            Tween(btn, { BackgroundTransparency = 1 }, 0.15)
        end)
        btn.MouseButton1Click:Connect(function()
            Spring(btn, { Size = UDim2.new(0.97, 0, 0, SC(40)) }, 0.1)
            task.wait(0.1)
            Spring(btn, { Size = UDim2.new(1, 0, 0, SC(40)) }, 0.15)
            if data.Callback then data.Callback() end
        end)
        return btn
    end
    
    -- UNLIMITED VALUE INPUT (TextBox)
    function Tab:AddValue(data)
        data = data or {}
        local holder = New("Frame", {
            Size = UDim2.new(1, 0, 0, SC(42)),
            BackgroundTransparency = 1,
            Parent = page,
        })
        Corner(holder, 8)
        Stroke(holder, Theme.StrokeColor)
        
        New("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, SC(12), 0, 0),
            Size = UDim2.new(0.5, -SC(16), 1, 0),
            Font = Theme.Font,
            Text = data.Text or "Value",
            TextColor3 = Theme.TextColor,
            TextSize = SC(12),
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = holder,
        })
        
        local box = New("TextBox", {
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -SC(8), 0.5, 0),
            Size = UDim2.new(0, SC(100), 0, SC(28)),
            BackgroundTransparency = 0.9,
            BackgroundColor3 = Theme.CardColor,
            Text = tostring(data.Default or 0),
            Font = Theme.FontBold,
            TextColor3 = Theme.TextColor,
            TextSize = SC(12),
            ClearTextOnFocus = false,
            Parent = holder,
        })
        Corner(box, 6)
        Stroke(box, Theme.Accent)
        
        box.FocusLost:Connect(function()
            local num = tonumber(box.Text)
            if num then
                if data.Min and num < data.Min then num = data.Min box.Text = tostring(num) end
                if data.Max and num > data.Max then num = data.Max box.Text = tostring(num) end
                if data.Callback then data.Callback(num) end
            else
                box.Text = tostring(data.Default or 0)
            end
        end)
        return holder, box
    end
    
    function Tab:AddLabel(text)
        return New("TextLabel", {
            Size = UDim2.new(1, 0, 0, SC(20)),
            BackgroundTransparency = 1,
            Font = Theme.Font,
            Text = text or "",
            TextColor3 = Theme.SubTextColor,
            TextSize = SC(11),
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = page,
        })
    end
    
    function Tab:AddDropdown(data)
        data = data or {}
        local selected = data.Default or (data.Options and data.Options[1]) or ""
        local holder = New("Frame", {
            Size = UDim2.new(1, 0, 0, SC(42)),
            BackgroundTransparency = 1,
            Parent = page,
        })
        Corner(holder, 8)
        Stroke(holder, Theme.StrokeColor)
        
        New("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, SC(12), 0, 0),
            Size = UDim2.new(1, -SC(140), 1, 0),
            Font = Theme.Font,
            Text = data.Text or "Select",
            TextColor3 = Theme.TextColor,
            TextSize = SC(12),
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = holder,
        })
        
        local btn = New("TextButton", {
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -SC(8), 0.5, 0),
            Size = UDim2.new(0, SC(120), 0, SC(28)),
            BackgroundTransparency = 0.9,
            BackgroundColor3 = Theme.CardColor,
            Text = selected,
            Font = Theme.Font,
            TextColor3 = Theme.TextColor,
            TextSize = SC(11),
            Parent = holder,
        })
        Corner(btn, 6)
        Stroke(btn, Theme.Accent)
        
        btn.MouseButton1Click:Connect(function()
            if data.Options then
                local idx = table.find(data.Options, selected) or 1
                idx = idx % #data.Options + 1
                selected = data.Options[idx]
                btn.Text = selected
                if data.Callback then data.Callback(selected) end
            end
        end)
        return holder
    end
    
    return Tab
end

