-----------------------------------------------------------------
-- VERSION DETECTION (Legacy vs Overhaul)
-----------------------------------------------------------------
local EvadeVersion = "Unknown"
local GameFolder = nil
local EventsFolder = nil
local NextbotsFolder = nil

-- Try Overhaul first
pcall(function()
    local overhaulCheck = Services.Workspace:FindFirstChild("Game") 
        or Services.ReplicatedStorage:FindFirstChild("Overhaul")
        or Services.ReplicatedStorage:FindFirstChild("EvadeOverhaul")
    if overhaulCheck then
        EvadeVersion = "Overhaul"
        GameFolder = Services.Workspace:FindFirstChild("Game")
        EventsFolder = Services.ReplicatedStorage:FindFirstChild("Events") 
            or Services.ReplicatedStorage:FindFirstChild("RemoteEvents")
        NextbotsFolder = Services.Workspace:FindFirstChild("Nextbots")
            or Services.Workspace:FindFirstChild("Bots")
            or (GameFolder and GameFolder:FindFirstChild("Nextbots"))
    end
end)

-- Fallback to Legacy
if EvadeVersion == "Unknown" then
    pcall(function()
        EventsFolder = Services.ReplicatedStorage:FindFirstChild("Events")
            or Services.ReplicatedStorage:FindFirstChild("Remotes")
        NextbotsFolder = Services.Workspace:FindFirstChild("Nextbots")
            or Services.Workspace:FindFirstChild("Monsters")
            or Services.Workspace:FindFirstChild("Bots")
        if EventsFolder then
            EvadeVersion = "Legacy"
        end
    end)
end

-- Final fallback - scan everything
if EvadeVersion == "Unknown" then
    for _, child in ipairs(Services.ReplicatedStorage:GetChildren()) do
        if child:IsA("Folder") and (child.Name:lower():find("event") or child.Name:lower():find("remote")) then
            EventsFolder = child
            EvadeVersion = "Legacy"
            break
        end
    end
    for _, child in ipairs(Services.Workspace:GetChildren()) do
        if child:IsA("Folder") and (child.Name:lower():find("bot") or child.Name:lower():find("monster")) then
            NextbotsFolder = child
            break
        end
    end
end

-- Version-specific helpers
local function FireEvent(eventName, ...)
    if not EventsFolder then return end
    local evt = EventsFolder:FindFirstChild(eventName)
    if evt and evt:IsA("RemoteEvent") then
        pcall(function() evt:FireServer(...) end)
    elseif evt and evt:IsA("RemoteFunction") then
        pcall(function() evt:InvokeServer(...) end)
    else
        local altNames = {
            Respawn = {"Respawn", "RequestRespawn", "PlayerRespawn"},
            Revive = {"Revive", "RequestRevive", "PlayerRevive", "RevivePlayer"},
            Carry = {"Carry", "RequestCarry", "PickUp", "CarryPlayer"},
            Dash = {"Dash", "RequestDash", "PlayerDash"},
            Whistle = {"Whistle", "RequestWhistle", "UseWhistle"},
            Vote = {"Vote", "CastVote", "SubmitVote"},
            Emote = {"Emote", "PlayEmote", "DoEmote"},
            Taunt = {"Taunt", "DoTaunt"},
            Roll = {"Roll", "DodgeRoll", "DoRoll"},
            Flip = {"Flip", "DoFlip", "Backflip"},
            Crawl = {"Crawl", "SetCrawling", "ToggleCrawl"},
            Peek = {"Peek", "SetPeeking", "TogglePeek"},
            Collect = {"Collect", "Pickup", "GrabItem", "CollectItem"},
            BuyItem = {"BuyItem", "PurchaseItem", "ShopBuy"},
            RedeemCode = {"RedeemCode", "CodeRedeem", "SubmitCode"},
            SetWeather = {"SetWeather", "ChangeWeather", "Weather"},
        }
        local alts = altNames[eventName]
        if alts then
            for _, alt in ipairs(alts) do
                local altEvt = EventsFolder:FindFirstChild(alt)
                if altEvt then
                    pcall(function() altEvt:FireServer(...) end)
                    return
                end
            end
        end
    end
end

local function GetNextbots()
    local bots = {}
    if NextbotsFolder then
        for _, bot in ipairs(NextbotsFolder:GetChildren()) do
            table.insert(bots, bot)
        end
    end
    for _, obj in ipairs(Services.Workspace:GetDescendants()) do
        if obj:IsA("Model") and (obj.Name:lower():find("nextbot") or obj.Name:lower():find("monster") or obj.Name:lower():find("bot_")) then
            if not table.find(bots, obj) then
                table.insert(bots, obj)
            end
        end
    end
    return bots
end

