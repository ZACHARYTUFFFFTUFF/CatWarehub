                if Services.UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += camCF.RightVector end
                if Services.UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0, 1, 0) end
                if Services.UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir -= Vector3.new(0, 1, 0) end
                if moveDir.Magnitude > 0 then
                    bv.Velocity = moveDir.Unit * flySpd
                else
                    bv.Velocity = Vector3.zero
                end
            end
            if bv then bv:Destroy() end
        end)
    end
})

